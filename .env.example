# ==============================================================================
# ShopEase AI - Enterprise E-Commerce Platform Configuration
# ==============================================================================

# Application & Environment
PROJECT_NAME="ShopEase AI"
PROJECT_DESCRIPTION="Enterprise AI-Powered E-Commerce Storefront & Operations Platform"
VERSION="1.0.0"
DEBUG=True

# Store Configuration
STORE_NAME="ShopEase AI"
STORE_CURRENCY="INR"
STORE_CURRENCY_SYMBOL="₹"
SHIPPING_FLAT_RATE=50.0
FREE_SHIPPING_THRESHOLD=999.0
TAX_RATE=0.05

# Database Configuration
# Default: Local SQLite (store.db) with automatic schema migration
DATABASE_URL="sqlite:///store.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/shopease_db"

# Security & Authentication (Generate secure secret in production with: openssl rand -hex 32)
JWT_SECRET_KEY="shopease-super-secure-production-secret-key-change-in-prod"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider Configuration
# Supported providers: gemini, groq
DEFAULT_AI_PROVIDER="gemini"
GEMINI_MODEL="gemini-1.5-flash"
GROQ_MODEL="llama-3.3-70b-versatile"

# API Keys (Never commit actual keys)
GEMINI_API_KEY="your-google-gemini-api-key-here"
GROQ_API_KEY="your-groq-api-key-here"

# Payment Gateways (sandbox | razorpay | stripe)
PAYMENT_PROVIDER="sandbox"
# Razorpay Credentials (Optional / Production):
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Stripe Credentials (Optional / Production):
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
